# Ensure output directory / file setup
OUTPUT_FILE="wireless-info.txt"
ARCHIVE_FILE="wireless-info.tar.gz"

echo "Running Wireless Info Script..."
echo "=========================================================="

# Remove older diagnostic files in the current working directory if present
rm -f "$OUTPUT_FILE" "$ARCHIVE_FILE"

# --- [ DIAGNOSTIC COLLECTION BLOCK ] ---
{
    echo "=== System Info ==="
    uname -a
    echo ""

    echo "=== PCI Wireless Devices ==="
    lspci -nnk | grep -iA3 net
    echo ""

    echo "=== USB Wireless Devices ==="
    lsusb
    echo ""

    echo "=== Network Interfaces ==="
    ip addr || ifconfig
    echo ""

    echo "=== Wireless Status ==="
    iwconfig 2>&1
    echo ""

    echo "=== RFKill Status ==="
    rfkill list
    echo ""

    echo "=== Kernel Messages (dmesg) ==="
    dmesg | grep -iE 'wlan|wifi|ath|iwl|rtw|broadcom|b43|firmware' | tail -n 50
    echo ""
} > "$OUTPUT_FILE" 2>&1

echo "Diagnostic collection complete. Output saved to $OUTPUT_FILE."

# --- [ 200 KB FILE SIZE CHECK BLOCK ] ---
if [ -f "$OUTPUT_FILE" ]; then
    FILE_SIZE=$(wc -c < "$OUTPUT_FILE" 2>/dev/null)

    # Check if log exceeds 200 KB (200,000 bytes)
    if [ "$FILE_SIZE" -gt 200000 ]; then
        echo ""
        echo "Output file exceeds 200 KB limit. Creating archive '$ARCHIVE_FILE'..."
        tar -czf "$ARCHIVE_FILE" "$OUTPUT_FILE"
        echo "Archive created: $ARCHIVE_FILE"
    fi
fi

# --- [ PASTEBIN UPLOAD FUNCTION ] ---
do_pastebin_upload() {
    local file_to_paste="$1"
    local paste_url=""

    if [ ! -s "$file_to_paste" ]; then
        echo "Error: Output file is missing or empty." >&2
        return 1
    fi

    echo "Attempting to upload results to an online paste service..."

    # Option 1: termbin.com (No account required, standard TCP port 9999)
    if command -v nc >/dev/null 2>&1; then
        paste_url=$(nc termbin.com 9999 < "$file_to_paste" 2>/dev/null | tr -d '\r\n\0')
    elif [ -e /dev/tcp ]; then
        paste_url=$( (exec 3<>/dev/tcp/termbin.com/9999 && cat "$file_to_paste" >&3 && cat <&3) 2>/dev/null | tr -d '\r\n\0' )
    fi

    # Option 2: paste.rs (Fallback anonymous curl paste service)
    if [ -z "$paste_url" ] && command -v curl >/dev/null 2>&1; then
        paste_url=$(curl -sS --data-binary @"$file_to_paste" https://paste.rs 2>/dev/null | tr -d '\r\n\0')
    fi

    # Option 3: Legacy pastebinit fallback (if system configuration works)
    if [ -z "$paste_url" ] && command -v pastebinit >/dev/null 2>&1; then
        paste_url=$(pastebinit "$file_to_paste" 2>/dev/null | tr -d '\r\n\0')
    fi

    # Display results
    if [ -n "$paste_url" ]; then
        echo ""
        echo "=========================================================="
        echo " Wireless info successfully uploaded to:"
        echo " $paste_url"
        echo "=========================================================="
        echo ""
    else
        echo ""
        echo "Notice: Automatic paste failed. Please upload or attach"
        echo "the file '$file_to_paste' directly to your support thread."
        echo ""
    fi
}

# --- [ INTERACTIVE UPLOAD PROMPT ] ---
if command -v nc >/dev/null 2>&1 || command -v curl >/dev/null 2>&1 || command -v pastebinit >/dev/null 2>&1 || [ -e /dev/tcp ]; then
    echo ""
    read -r -p "Do you also want to post them to an online pastebin service? [Y/n]: " choice
    case "$choice" in
        [yY][eE][sS]|[yY]|"")
            if [ -f "$OUTPUT_FILE" ]; then
                do_pastebin_upload "$OUTPUT_FILE"
            elif [ -f "$ARCHIVE_FILE" ]; then
                echo "Uncompressing log file temporarily for paste service..."
                tar -xzf "$ARCHIVE_FILE"
                do_pastebin_upload "$OUTPUT_FILE"
            fi
            ;;
        *)
            echo "Skipped online upload. Results saved locally to $OUTPUT_FILE."
            ;;
    esac
fi
